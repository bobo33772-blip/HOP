# 카페24 개발자센터 > 앱 > 앱 정보에서 확인 (docs/CAFE24_SETUP.md 참고)
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
# 할인·배송 앱용 무결성 키 — 일반 앱은 비워 둠 (위젯 회원 검증 방식은 PoC P2에서 확정)
CAFE24_SERVICE_KEY=

# 이 앱이 외부에 노출되는 주소 (카페24에 등록한 Redirect URI와 같은 호스트)
APP_BASE_URL=http://localhost:3100

# 카페24 토큰을 DB에 암호화해 저장할 키 (32바이트 hex). 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=

# 비워 두면 로컬 내장 Postgres(PGlite)를 씁니다. 데모 모드는 메모리, 연동 모드는 .data/ 폴더
DATABASE_URL=

# 운영자 화면(/admin) 로그인 토큰, 24자 이상. 데모 모드에서 비워 두면 서버를 켤 때마다 새로 만들어 /demo 에 보여 줘요
# 생성: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_TOKEN=

# 서버 안 정기 작업(예약 문자·마감 판정·결제 기간 종료·03시 대사). 서버를 여러 대 띄우면 off로 끄고 외부 크론을 쓰세요
SCHEDULER=inline
# 외부 크론이 POST /api/cron/tick (Authorization: Bearer <값>)을 부를 때 쓰는 비밀값. 비워 두면 그 주소는 꺼져요
CRON_SECRET=

# 카페24 웹훅의 X-API-Key 헤더와 비교할 값 (PoC에서 앱별 고정 키인지 확인 후 채우기). 비워 두면 검사하지 않아요
WEBHOOK_API_KEY=

# 1이면 카페24 대신 가짜 데이터로 동작 (카페24 앱 등록 전 로컬 개발용)
CAFE24_MOCK=1

# 데모 몰에서 상품당 조회 지연(ms) — 첫 수집 화면 확인용
MOCK_DELAY_MS=150

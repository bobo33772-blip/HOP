# 실제 카페24 연동 실행용 (npm start). 값을 채운 .env는 커밋하지 마세요.
PORT=8787
PUBLIC_BASE_URL=https://jjim.example.com
# 운영자 로그인 토큰 (24자 이상, 무작위)
ADMIN_TOKEN=
# 카페24 토큰 암호화 키 (32자 이상, 무작위)
TOKEN_KEY=
DB_PATH=jjim-gonggu.db
# 카페24 개발자센터 앱 정보
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_API_VERSION=2026-09-01
# 웹훅 서명 검사용 (방식은 PoC에서 확인)
WEBHOOK_SECRET=
